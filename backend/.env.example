# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/todo_app
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/todo_app?retryWrites=true
MONGO_URI=mongodb://127.0.0.1:27017/todo_app

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -base64 64)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7
